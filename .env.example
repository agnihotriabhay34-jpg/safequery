# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional
EMBED_MODEL=all-MiniLM-L6-v2
TOP_K_TABLES=5
MAX_ROWS=200

# Profiling limits (bigger = more hallucination protection on huge tables, but slower connect)
PROFILE_MAX_ROWS=300000
PROFILE_QUERY_TIMEOUT_S=3
CACHE_TTL_HOURS=24

# Time limit for answering queries (seconds)
QUERY_TIMEOUT_S=10
